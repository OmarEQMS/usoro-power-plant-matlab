{
  "name": "usoro-plant-site",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation and learning site for the Usoro 47th-order drum boiler-turbine power plant model",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "book:html": "ts-node book/build-book.ts",
    "book": "ts-node book/build-book.ts && pagedjs-cli dist-book/book.html --outline-tags h1 -o dist-book/usoro-plant-book.pdf",
    "book:cover": "node book/render-cover.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "katex": "^0.16.11",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^22.7.0",
    "@types/prismjs": "^1.26.4",
    "css-loader": "^7.1.2",
    "gray-matter": "^4.0.3",
    "html-webpack-plugin": "^5.6.0",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "mini-css-extract-plugin": "^2.9.1",
    "pagedjs-cli": "^0.4.3",
    "sass": "^1.79.4",
    "sass-loader": "^16.0.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
